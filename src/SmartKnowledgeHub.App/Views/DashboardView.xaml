<UserControl x:Class="SmartKnowledgeHub.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel LastChildFill="True">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Dashboard" Style="{StaticResource TitleText}"/>
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionText}"/>
            </StackPanel>
            <Button Content="Refresh" Command="{Binding RefreshCommand}"
                    Style="{StaticResource FluentButton}"
                    HorizontalAlignment="Right" VerticalAlignment="Top"/>
        </Grid>

        <UniformGrid DockPanel.Dock="Top" Rows="1" Columns="4" Margin="0,0,0,16">
            <Border Style="{StaticResource StatCard}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Notes" Style="{StaticResource CaptionText}"/>
                    <TextBlock Text="{Binding NoteCount}" FontSize="28" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding PinnedNoteCount, StringFormat='{}{0} pinned'}" Style="{StaticResource CaptionText}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCard}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Open tasks" Style="{StaticResource CaptionText}"/>
                    <TextBlock FontSize="28" FontWeight="SemiBold">
                        <Run Text="{Binding TaskTodoCount, Mode=OneWay}"/>
                        <Run Text="/"/>
                        <Run Text="{Binding TaskDoingCount, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Text="{Binding TaskDoneCount, StringFormat='{}{0} done'}" Style="{StaticResource CaptionText}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCard}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Due this week" Style="{StaticResource CaptionText}"/>
                    <TextBlock Text="{Binding DueSoonCount}" FontSize="28" FontWeight="SemiBold"/>
                    <TextBlock Text="Not marked Done" Style="{StaticResource CaptionText}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="Files" Style="{StaticResource CaptionText}"/>
                    <TextBlock Text="{Binding FileCount}" FontSize="28" FontWeight="SemiBold"/>
                    <TextBlock Text="Local paths / vault" Style="{StaticResource CaptionText}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Recent notes" Style="{StaticResource SectionTitle}"/>
                    <ListBox ItemsSource="{Binding RecentNotes}" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="8">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                    <TextBlock Style="{StaticResource CaptionText}">
                                        <Run Text="{Binding NotebookName, Mode=OneWay}"/>
                                        <Run Text=" · "/>
                                        <Run Text="{Binding UpdatedUtc, Converter={StaticResource UtcToLocal}, ConverterParameter=g, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Due tasks" Style="{StaticResource SectionTitle}"/>
                    <ListBox ItemsSource="{Binding DueTasks}" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="8">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                    <TextBlock Style="{StaticResource CaptionText}">
                                        <Run Text="{Binding Status, Mode=OneWay}"/>
                                        <Run Text=" · due "/>
                                        <Run Text="{Binding DueUtc, Converter={StaticResource UtcToLocal}, ConverterParameter=d, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
