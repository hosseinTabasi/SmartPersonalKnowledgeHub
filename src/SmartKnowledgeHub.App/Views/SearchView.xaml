<UserControl x:Class="SmartKnowledgeHub.App.Views.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="Search" Style="{StaticResource TitleText}"/>
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
        </StackPanel>
        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Style="{StaticResource SearchBox}"
                     Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,8,0">
                <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding RunSearchCommand}"/>
                </TextBox.InputBindings>
            </TextBox>
            <Button Grid.Column="1" Content="Search" Command="{Binding RunSearchCommand}" Style="{StaticResource PrimaryButton}" Margin="0"/>
        </Grid>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <RadioButton Content="Keywords (FTS5 / bm25)"
                         IsChecked="{Binding UseRelatedMeaning, Converter={StaticResource InverseBool}}"
                         GroupName="Mode"/>
            <RadioButton Content="Related meaning"
                         IsChecked="{Binding UseRelatedMeaning}"
                         GroupName="Mode"/>
            <Button Content="Rebuild index" Command="{Binding RebuildIndexCommand}" Style="{StaticResource FluentButton}"/>
        </StackPanel>
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource CaptionText}" Margin="0,0,0,8"
                   Text="{Binding EmbeddingName, StringFormat='Embedding: {0}'}"/>
        <Border Style="{StaticResource Card}" Padding="8">
            <ListBox ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedHit}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="8">
                            <TextBlock FontWeight="SemiBold">
                                <Run Text="{Binding Title, Mode=OneWay}"/>
                                <Run Text="  "/>
                                <Run Text="{Binding EntityType, Mode=OneWay}" Foreground="#FF5D5D5D"/>
                            </TextBlock>
                            <TextBlock Text="{Binding Snippet}" TextWrapping="Wrap" Style="{StaticResource CaptionText}"/>
                            <TextBlock Style="{StaticResource CaptionText}">
                                <Run Text="{Binding Source, Mode=OneWay}"/>
                                <Run Text=" · score "/>
                                <Run Text="{Binding Score, Converter={StaticResource ScoreText}, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </DockPanel>
</UserControl>
