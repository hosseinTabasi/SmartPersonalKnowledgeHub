<UserControl x:Class="SmartKnowledgeHub.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Settings" Style="{StaticResource TitleText}" Margin="0,0,0,4"/>
            <TextBlock Text="All data stays on this computer. There is no account and no telemetry."
                       Style="{StaticResource CaptionText}" Margin="0,0,0,16"/>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Data folder" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="Root" Style="{StaticResource CaptionText}"/>
                    <TextBox Text="{Binding DataFolder, Mode=OneWay}" IsReadOnly="True" Margin="0,0,0,8"/>
                    <TextBlock Text="SQLite database" Style="{StaticResource CaptionText}"/>
                    <TextBox Text="{Binding DatabasePath, Mode=OneWay}" IsReadOnly="True" Margin="0,0,0,8"/>
                    <TextBlock Text="File vault" Style="{StaticResource CaptionText}"/>
                    <TextBox Text="{Binding VaultFolder, Mode=OneWay}" IsReadOnly="True" Margin="0,0,0,12"/>
                    <Button Content="Open data folder" Command="{Binding OpenDataFolderCommand}" Style="{StaticResource FluentButton}" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Search engines" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="{Binding EmbeddingName}" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding OnnxStatus}" TextWrapping="Wrap" Style="{StaticResource CaptionText}" Margin="0,0,0,12"/>
                    <Button Content="Rebuild TF-IDF index" Command="{Binding RebuildSearchCommand}" Style="{StaticResource FluentButton}" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Maintenance" Style="{StaticResource SectionTitle}"/>
                    <WrapPanel>
                        <Button Content="Seed sample data" Command="{Binding SeedSampleDataCommand}" Style="{StaticResource PrimaryButton}"/>
                        <Button Content="VACUUM database" Command="{Binding VacuumCommand}" Style="{StaticResource FluentButton}"/>
                        <Button Content="Backup SQLite file" Command="{Binding BackupCommand}" Style="{StaticResource FluentButton}"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding StatusText}" Margin="0,12,0,0" TextWrapping="Wrap"/>
                    <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Style="{StaticResource CaptionText}"
                               Text="Sample data is skipped if notes or tasks already exist. Backup writes a timestamped copy under the backups folder."/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
