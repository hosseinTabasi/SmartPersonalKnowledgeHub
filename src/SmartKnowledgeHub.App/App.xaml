<Application x:Class="SmartKnowledgeHub.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SmartKnowledgeHub.App.Views"
             xmlns:vm="clr-namespace:SmartKnowledgeHub.App.ViewModels"
             xmlns:converters="clr-namespace:SmartKnowledgeHub.App.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Fluent.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True"/>
            <converters:NullToVisibilityConverter x:Key="NullToVis"/>
            <converters:UtcToLocalConverter x:Key="UtcToLocal"/>
            <converters:BytesToSizeConverter x:Key="BytesToSize"/>
            <converters:PriorityToTextConverter x:Key="PriorityText"/>
            <converters:ScoreToPercentConverter x:Key="ScoreText"/>
            <converters:InverseBoolConverter x:Key="InverseBool"/>
            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                <views:DashboardView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:NotesViewModel}">
                <views:NotesView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:TasksViewModel}">
                <views:TasksView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:FilesViewModel}">
                <views:FilesView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SearchViewModel}">
                <views:SearchView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView/>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
